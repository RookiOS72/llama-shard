<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.llama-shard.slot-pin-proxy</string>

    <key>Comment</key>
    <string>llama-shard: pins openclaw's completion requests to a fixed llama-server slot, see proxy/slot_pin_proxy.py</string>

    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/python3</string>
      <string>/Users/brenden/dev/llama-shard/proxy/slot_pin_proxy.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>LLAMA_SHARD_UPSTREAM_HOST</key>
      <string>127.0.0.1</string>
      <key>LLAMA_SHARD_UPSTREAM_PORT</key>
      <string>8080</string>
      <key>LLAMA_SHARD_PROXY_PORT</key>
      <string>8090</string>
      <key>LLAMA_SHARD_PINNED_SLOT</key>
      <string>0</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/brenden/dev/llama-shard/proxy</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ExitTimeOut</key>
    <integer>20</integer>

    <key>StandardInPath</key>
    <string>/dev/null</string>
    <key>StandardOutPath</key>
    <string>/Users/brenden/Library/Logs/llama-shard/slot-pin-proxy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/brenden/Library/Logs/llama-shard/slot-pin-proxy.log</string>
  </dict>
</plist>
